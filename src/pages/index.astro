---
import LandingLayout from "../layouts/LandingLayout.astro";
---

<LandingLayout>

<!-- ═══════════════════════════════════════════════════════════
     NAV
═══════════════════════════════════════════════════════════ -->
<nav class="l-nav" id="top">
  <div class="l-nav__inner">
    <a href="#top" class="l-nav__logo">
      <img src="/logo-census.svg" alt="Census Consultores" class="l-nav__logo-img" />
    </a>
    <button class="l-nav__burger" id="navBurger" aria-label="Menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <ul class="l-nav__links" id="navLinks">
      <li><a href="#portales">Portales</a></li>
      <li><a href="#como-funciona">Cómo funciona</a></li>
      <li><a href="#beneficios">Beneficios</a></li>
      <li>
        <a href="/formulario" class="l-nav__cta">Solicitar servicio</a>
      </li>
    </ul>
  </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════════ -->
<section class="l-hero" id="hero">
  <div class="l-hero__glow" aria-hidden="true"></div>
  <div class="l-container l-hero__inner">

    <div class="l-hero__copy">
      <p class="l-eyebrow">Monitoreo Integral 360°</p>
      <h1 class="l-hero__title">
        Antes de<br />cualquier sorpresa:<br />
        <em>Census Alert.</em>
      </h1>
      <p class="l-hero__sub">
        Monitoreo diario para detectar deudas, novedades y alertas
        registradas en fuentes públicas. Tecnología diseñada para darte
        visibilidad inmediata sobre tus obligaciones legales y tributarias,
        para que actúes a tiempo.
      </p>
      <div class="l-hero__ctas">
        <a href="/formulario" class="btn-gold">Quiero monitorear mi empresa</a>
        <a href="#como-funciona" class="btn-outline">Ver cómo funciona</a>
      </div>
      <p class="l-hero__note">
        <span class="dot-live"></span>
        13 fuentes oficiales · Revisión automática diaria · Sin instalar nada
      </p>
    </div>

    <div class="l-hero__visual">
      <div class="l-hero__robot-wrap">
        <img
          src="/robot-alert.png"
          alt="Census Alert"
          class="l-hero__robot-img"
        />
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     PORTALES QUE REVISAMOS
═══════════════════════════════════════════════════════════ -->
<section class="l-section l-section--alt" id="portales">
  <div class="l-container">
    <div class="l-section-head">
      <p class="l-eyebrow">Cobertura oficial</p>
      <h2>13 portales del Estado. <br class="br-desktop"/>Un solo informe.</h2>
      <p class="l-section-sub">
        Consultamos directamente las fuentes oficiales, no intermediarios.
        Si hay algo en tu nombre, lo encontramos.
      </p>
    </div>

    <div class="l-cat-grid">

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Balanza de justicia -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <polygon points="12,2 9.5,6 14.5,6"/>
            <rect x="2" y="5.5" width="20" height="1.5" rx="0.75"/>
            <rect x="11.25" y="7" width="1.5" height="11" rx="0.5"/>
            <rect x="3" y="7" width="1" height="5"/>
            <rect x="20" y="7" width="1" height="5"/>
            <path d="M1,12 A3,3 0 0,1 7,12 Z"/>
            <path d="M17,12 A3,3 0 0,1 23,12 Z"/>
            <rect x="9" y="18" width="6" height="2" rx="1"/>
          </svg>
          <span class="l-cat__title">Tributario y Laboral</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">SRI</span>
            <span class="l-source__desc">Deudas tributarias firmes, impugnadas y en facilidades de pago.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">IESS</span>
            <span class="l-source__desc">Mora patronal — aportes en mora y valores adeudados al seguro social.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">Minist. del Trabajo</span>
            <span class="l-source__desc">Obligaciones laborales y actas del Ministerio del Trabajo.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">SUPA</span>
            <span class="l-source__desc">Deudas por pensiones alimenticias registradas en el sistema.</span>
          </li>
        </ul>
      </div>

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Columnas clásicas / Palacio de Justicia -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <polygon points="12,2 1,7 23,7"/>
            <rect x="1" y="7" width="22" height="1.5"/>
            <rect x="3" y="8.5" width="2.5" height="11" rx="0.5"/>
            <rect x="10.75" y="8.5" width="2.5" height="11" rx="0.5"/>
            <rect x="18.5" y="8.5" width="2.5" height="11" rx="0.5"/>
            <rect x="1" y="19.5" width="22" height="2.5" rx="1"/>
          </svg>
          <span class="l-cat__title">Judicial y Penal</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">SATJE — Función Judicial</span>
            <span class="l-source__desc">Demandas y causas judiciales activas en tu contra.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">Fiscalía (SIAF)</span>
            <span class="l-source__desc">Noticias del delito y denuncias penales registradas.</span>
          </li>
        </ul>
      </div>

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Velocímetro / Tránsito -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd"
              d="M12 3a9 9 0 1 0 0 18A9 9 0 0 0 12 3zm0 2a7 7 0 1 1 0 14A7 7 0 0 1 12 5z"/>
            <path d="M6.34 8.05a1 1 0 0 1 1.32 1.5L6.5 10.67a1 1 0 1 1-1.32-1.5l1.16-1.12z"/>
            <path d="M17.66 8.05a1 1 0 0 0-1.32 1.5l1.16 1.12a1 1 0 1 0 1.32-1.5l-1.16-1.12z"/>
            <rect x="11" y="7" width="2" height="4" rx="1"/>
            <circle cx="12" cy="17" r="1.5"/>
            <rect x="5" y="12.5" width="3.5" height="1.5" rx="0.75"/>
            <rect x="15.5" y="12.5" width="3.5" height="1.5" rx="0.75"/>
            <path d="M12 13.5 L14.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="l-cat__title">Tránsito</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">ANT</span>
            <span class="l-source__desc">Multas de tránsito a nivel nacional.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">ATM — Guayaquil</span>
            <span class="l-source__desc">Citaciones y multas del cantón Guayaquil.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">CTE</span>
            <span class="l-source__desc">Multas viales de la Comisión de Tránsito del Ecuador.</span>
          </li>
        </ul>
      </div>

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Escudo con check / Certificación -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L3 6v7c0 4.4 3.9 8.5 9 9.9C18.1 21.5 21 17.4 21 13V6L12 2z"/>
            <path d="M8.5 12.5l2 2 5-5 1 1-6 6-3-3 1-1z" fill="#0f0f0c"/>
          </svg>
          <span class="l-cat__title">Societario y Contratación</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">Superintendencia de Compañías</span>
            <span class="l-source__desc">Situación societaria, multas y obligaciones vigentes.</span>
          </li>
          <li class="l-source">
            <span class="l-source__name">SERCOP</span>
            <span class="l-source__desc">Estado en compras públicas, inhabilidades y certificado de proveedor.</span>
          </li>
        </ul>
      </div>

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Avión / Migración -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="12" cy="12" rx="2" ry="9"/>
            <path d="M2,12.5 L10,10.5 L10,14.5 Z"/>
            <path d="M22,12.5 L14,10.5 L14,14.5 Z"/>
            <path d="M6.5,20 L10,18.5 L10,21.5 Z"/>
            <path d="M17.5,20 L14,18.5 L14,21.5 Z"/>
          </svg>
          <span class="l-cat__title">Migratorio</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">Migración Ecuador</span>
            <span class="l-source__desc">Impedimentos de salida del país vigentes.</span>
          </li>
        </ul>
      </div>

      <div class="l-cat">
        <div class="l-cat__header">
          <!-- Municipio / Cúpula -->
          <svg class="l-cat__icon-svg" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" xmlns="http://www.w3.org/2000/svg">
            <path d="M4,13 A8,8 0 0,1 20,13 Z"/>
            <rect x="6" y="13" width="12" height="2"/>
            <rect x="3" y="15" width="18" height="7" rx="1"/>
            <rect x="10.5" y="17.5" width="3" height="4.5" fill="#0f0f0c"/>
            <rect x="5" y="17" width="2.5" height="2.5" rx="0.4" fill="#0f0f0c"/>
            <rect x="16.5" y="17" width="2.5" height="2.5" rx="0.4" fill="#0f0f0c"/>
          </svg>
          <span class="l-cat__title">Municipal</span>
        </div>
        <ul class="l-sources">
          <li class="l-source">
            <span class="l-source__name">Municipio de Samborondón</span>
            <span class="l-source__desc">Deudas municipales de predial, tasas y contribuciones.</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="l-data-detail">
      <h3>¿Qué información extraemos de cada portal?</h3>
      <div class="l-data-pills">
        <span class="l-pill">Montos adeudados</span>
        <span class="l-pill">Estado de la obligación</span>
        <span class="l-pill">Fechas de vencimiento</span>
        <span class="l-pill">N.º de causa / citación / denuncia</span>
        <span class="l-pill">Razón social y estado del contribuyente</span>
        <span class="l-pill">Verificado contra la fuente oficial</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     CÓMO SE PRESENTA LA INFORMACIÓN
═══════════════════════════════════════════════════════════ -->
<section class="l-section" id="informes">
  <div class="l-container">
    <div class="l-section-head">
      <p class="l-eyebrow">Entrega de resultados</p>
      <h2>La información, ordenada y lista para actuar.</h2>
    </div>

    <div class="l-delivery-grid">

      <div class="l-delivery-card">
        <div class="l-delivery-card__icon">
          <!-- Documento con página doblada -->
          <svg class="l-icon-glow" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 2h9l5 5v15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/>
            <path d="M14 2l5 5h-5z" fill="#0f0f0c"/>
            <rect x="7" y="10" width="10" height="1.5" rx="0.75" fill="#0f0f0c"/>
            <rect x="7" y="13" width="8"  height="1.5" rx="0.75" fill="#0f0f0c"/>
            <rect x="7" y="16" width="6"  height="1.5" rx="0.75" fill="#0f0f0c"/>
          </svg>
        </div>
        <h3>Informe Consolidado 360°</h3>
        <p>
          Un único reporte por cliente: una sección por fuente, estado
          claro (<strong>Al día / Novedad / Pendiente</strong>), montos
          y detalle. Entregado por correo y disponible en PDF con la
          marca Census.
        </p>
        <div class="l-mini-report">
          <div class="l-mini-report__row">
            <span>SRI — Obligaciones tributarias</span>
            <span class="badge badge--ok">Al día</span>
          </div>
          <div class="l-mini-report__row">
            <span>IESS — Mora patronal</span>
            <span class="badge badge--alert">Novedad · $1.240</span>
          </div>
          <div class="l-mini-report__row">
            <span>SATJE — Causas judiciales</span>
            <span class="badge badge--ok">Al día</span>
          </div>
          <div class="l-mini-report__row">
            <span>ANT — Multas de tránsito</span>
            <span class="badge badge--pending">Pendiente</span>
          </div>
        </div>
      </div>

      <div class="l-delivery-card">
        <div class="l-delivery-card__icon">
          <!-- Campana de notificación -->
          <svg class="l-icon-glow" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 1a1 1 0 0 1 1 1v.6A7 7 0 0 1 19 9.5V14l1.7 1.7A1 1 0 0 1 20 17.5H4a1 1 0 0 1-.7-1.8L5 14V9.5a7 7 0 0 1 6-6.9V2a1 1 0 0 1 1-1z"/>
            <path d="M9.5 17.5a2.5 2.5 0 0 0 5 0h-5z"/>
          </svg>
        </div>
        <h3>Feed de Novedades</h3>
        <p>
          Lista cronológica de los cambios detectados: nueva deuda, nueva
          multa, nueva demanda, nueva denuncia. Solo lo nuevo, sin repetir
          lo que ya sabías.
        </p>
        <div class="l-feed">
          <div class="l-feed__item l-feed__item--alert">
            <span class="l-feed__dot"></span>
            <div>
              <span class="l-feed__time">Hoy, 06:45</span>
              <span class="l-feed__text">IESS: mora patronal registrada — $1.240,00</span>
            </div>
          </div>
          <div class="l-feed__item">
            <span class="l-feed__dot l-feed__dot--ok"></span>
            <div>
              <span class="l-feed__time">Ayer, 06:45</span>
              <span class="l-feed__text">SRI: sin novedades</span>
            </div>
          </div>
          <div class="l-feed__item">
            <span class="l-feed__dot l-feed__dot--ok"></span>
            <div>
              <span class="l-feed__time">Hace 2 días, 06:45</span>
              <span class="l-feed__text">SATJE: sin nuevas causas</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     CÓMO FUNCIONA — 4 PASOS
═══════════════════════════════════════════════════════════ -->
<section class="l-section l-section--alt" id="como-funciona">
  <div class="l-container">
    <div class="l-section-head">
      <p class="l-eyebrow">El proceso</p>
      <h2>Automático. Silencioso. Preciso.</h2>
      <p class="l-section-sub">
        Sin intervención manual. Todos los días, antes de que tu jornada empiece.
      </p>
    </div>

    <div class="l-steps">
      <div class="l-step">
        <div class="l-step__num">01</div>
        <div class="l-step__body">
          <h3>Vigilamos</h3>
          <p>Consultamos las 13 fuentes oficiales cada madrugada, de forma automática y sin fallas.</p>
        </div>
      </div>
      <div class="l-step__arrow" aria-hidden="true">→</div>
      <div class="l-step">
        <div class="l-step__num">02</div>
        <div class="l-step__body">
          <h3>Detectamos el cambio</h3>
          <p>Comparamos contra el último estado conocido. Solo marcamos lo que es realmente nuevo.</p>
        </div>
      </div>
      <div class="l-step__arrow" aria-hidden="true">→</div>
      <div class="l-step">
        <div class="l-step__num">03</div>
        <div class="l-step__body">
          <h3>Consolidamos</h3>
          <p>Armamos un informe único, claro y estructurado por fuente, con estado, montos y detalle.</p>
        </div>
      </div>
      <div class="l-step__arrow" aria-hidden="true">→</div>
      <div class="l-step">
        <div class="l-step__num">04</div>
        <div class="l-step__body">
          <h3>Te notificamos</h3>
          <p>Un solo correo por cliente, con copias a los destinatarios que tú configures. Sin spam.</p>
        </div>
      </div>
    </div>

    <div class="l-highlight-box">
      <svg class="l-icon-glow l-highlight-box__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="width:28px;height:28px;">
        <path d="M12 2L3 6v7c0 4.4 3.9 8.5 9 9.9C18.1 21.5 21 17.4 21 13V6L12 2z"/>
        <path d="M8.5 12.5l2 2 5-5 1 1-6 6-3-3 1-1z" fill="#0f0f0c"/>
      </svg>
      <div>
        <strong>Solo datos de fuentes oficiales públicas.</strong>
        No usamos intermediarios, no cruzamos datos privados. Todo lo que
        informamos está disponible en los portales del Estado ecuatoriano.
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     BENEFICIOS
═══════════════════════════════════════════════════════════ -->
<section class="l-section" id="beneficios">
  <div class="l-container">
    <div class="l-section-head">
      <p class="l-eyebrow">Por qué Census Alert</p>
      <h2>Entérate antes, no después.</h2>
    </div>

    <div class="l-benefits-grid">
      <div class="l-benefit">
        <!-- Reloj -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10"/>
          <rect x="11" y="5"  width="2" height="7"  rx="1" fill="#0f0f0c"/>
          <rect x="12" y="11" width="5" height="2"  rx="1" fill="#0f0f0c"/>
          <circle cx="12" cy="12" r="1.5" fill="#0f0f0c"/>
        </svg>
        <h3>Ahorra horas de revisión manual</h3>
        <p>Revisar 13 portales cada día toma horas. Census Alert lo hace en minutos, sin error humano.</p>
      </div>
      <div class="l-benefit">
        <!-- Triángulo de alerta -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L1 21h22L12 2z"/>
          <rect x="11" y="9"  width="2" height="6" rx="1" fill="#0f0f0c"/>
          <circle cx="12" cy="17.5" r="1.2" fill="#0f0f0c"/>
        </svg>
        <h3>Evita sorpresas costosas</h3>
        <p>Embargos, inhabilidades, salidas bloqueadas: todas tienen señales previas. Nosotros las detectamos.</p>
      </div>
      <div class="l-benefit">
        <!-- Rayo -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M14 2L5 13h8l-3 9 12-12h-9z"/>
        </svg>
        <h3>Reacciona a tiempo</h3>
        <p>Con 24 horas de anticipación puedes impugnar, pagar, o asesorarte. Sin monitoreo, no hay margen.</p>
      </div>
      <div class="l-benefit">
        <!-- Portapapeles / dashboard -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <rect x="4"  y="4" width="16" height="18" rx="2"/>
          <rect x="9"  y="2" width="6"  height="4"  rx="1"/>
          <rect x="7"  y="10" width="10" height="1.5" rx="0.75" fill="#0f0f0c"/>
          <rect x="7"  y="13.5" width="10" height="1.5" rx="0.75" fill="#0f0f0c"/>
          <rect x="7"  y="17" width="7"  height="1.5" rx="0.75" fill="#0f0f0c"/>
        </svg>
        <h3>Todo en un solo lugar</h3>
        <p>Un informe, un correo, un estado por fuente. Sin navegar portal por portal ni recordar contraseñas.</p>
      </div>
      <div class="l-benefit">
        <!-- Candado -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="11" width="16" height="12" rx="3"/>
          <path fill-rule="evenodd" d="M12 2a5 5 0 0 1 5 5v4H7V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v3h6V7a3 3 0 0 0-3-3z"/>
          <circle cx="12" cy="16.5" r="2"   fill="#0f0f0c"/>
          <rect   x="11" y="17.5"  width="2" height="3" fill="#0f0f0c"/>
        </svg>
        <h3>13 fuentes oficiales cubiertas</h3>
        <p>La cobertura más amplia disponible: tributario, laboral, judicial, tránsito, societario, migratorio y municipal.</p>
      </div>
      <div class="l-benefit">
        <!-- Diana / bullseye -->
        <svg class="l-icon-glow l-benefit__icon" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="7"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="12" cy="12" r="1.5"/>
        </svg>
        <h3>Solo lo nuevo, sin ruido</h3>
        <p>Detección inteligente de cambios: solo te avisamos cuando algo cambia, no todos los días con lo mismo.</p>
      </div>
    </div>
  </div>
