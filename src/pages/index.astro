<script>
  // Menú móvil
  const burger = document.getElementById("navBurger");
  const links = document.getElementById("navLinks");
  if (burger && links) {
    burger.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", String(!open));
      links.classList.toggle("is-open", !open);
    });
    links.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        burger.setAttribute("aria-expanded", "false");
        links.classList.remove("is-open");
      });
    });
  }

  // La barra se vuelve sólida en cuanto la portada empieza a subir.
  // Con un centinela y no con un escuchador de scroll: el navegador
  // solo avisa cuando cruza el umbral, en vez de en cada píxel.
  const centinela = document.querySelector(".centinela");
  const barra = document.querySelector(".nav");
  if (centinela && barra) {
    new IntersectionObserver(
      ([e]) => barra.classList.toggle("solido", !e.isIntersecting),
      { rootMargin: "0px" },
    ).observe(centinela);
  }

  // La secuencia del informe. Se ARMA en cuanto carga —así el estado
  // de partida no se ve saltar— y se DISPARA cuando la escena entra en
  // pantalla. Si el navegador no soporta el observador, se queda como
  // está: todo visible, que es el estado final.
  const escena = document.querySelector(".escena");
  if (escena && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    escena.classList.add("armada");
    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) { escena.classList.add("anima"); obs.disconnect(); }
        }
      }, { threshold: .25 });
      obs.observe(escena);
    } else {
      escena.classList.add("anima");
    }
  }


  // Revelado al entrar en pantalla. Escalonado solo dentro de los pares
  // que se leen juntos; el resto entra a su ritmo.
  const io = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        const d = Number((e.target as HTMLElement).dataset.d || 0);
        window.setTimeout(() => e.target.classList.add("on"), d);
        io.unobserve(e.target);
      });
    },
    { threshold: 0.14, rootMargin: "0px 0px -6% 0px" },
  );

  [".via .ruta", ".reloj .col"].forEach((sel) => {
    document.querySelectorAll<HTMLElement>(sel).forEach((el, i) => {
      el.dataset.d = String(i * 110);
    });
  });
  document.querySelectorAll(".rv").forEach((el) => io.observe(el));
</script>
