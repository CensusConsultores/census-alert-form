    flex-direction: column;
    border-bottom: none;
    border-right: 1px solid var(--l-border);
    padding: 0 28px 0 0;
  }
  .l-step:last-child { border-right: none; padding-right: 0; }
  .l-step__num { width: auto; }
  .l-hero__ctas { flex-wrap: nowrap; }
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE — DESKTOP  ≥ 1024px
═══════════════════════════════════════════════════════════ */
@media (min-width: 1024px) {
  .l-hero__inner {
    grid-template-columns: 1fr 420px;
    gap: 80px;
  }
  .l-cat-grid { grid-template-columns: repeat(3, 1fr); }
  .l-benefits-grid { grid-template-columns: repeat(3, 1fr); }
  .br-desktop { display: inline; }
  .l-nav__burger { display: none; }
}

/* ═══════════════════════════════════════════════════════════
   MOBILE NAV  < 640px
═══════════════════════════════════════════════════════════ */
@media (max-width: 639px) {
  .l-nav__burger { display: flex; }
  .l-nav__links {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: rgba(15,15,12,0.98);
    border-bottom: 1px solid var(--l-border);
    padding: 8px 0 16px;
    z-index: 99;
  }
  .l-nav__links.is-open { display: flex; }
  .l-nav__links li { width: 100%; }
  .l-nav__links a {
    display: block;
    padding: 14px 24px;
    font-size: 15px;
    border-bottom: 1px solid rgba(201,168,76,0.06);
  }
  .l-nav__links li:last-child a {
    margin: 12px 24px 0;
    padding: 12px 20px;
    border-bottom: none;
    text-align: center;
  }
  .l-hero { padding: 56px 0 48px; }
  .l-section { padding: 64px 0; }
  .l-cta-final { padding: 56px 0; }
  .l-delivery-card { padding: 24px; }
  .l-steps { gap: 0; }
}
</style>

<script>
  // Burger menu toggle
  const burger = document.getElementById('navBurger');
  const links  = document.getElementById('navLinks');
  if (burger && links) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      links.classList.toggle('is-open', !open);
    });
    // Cerrar al hacer click en un link del menú móvil
    links.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        links.classList.remove('is-open');
      });
    });
  }

  // Scroll suave para todos los href ancla
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const id = anchor.getAttribute('href');
      const target = document.querySelector(id);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // ── Hero golden dust particles ────────────────────────────
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hero = document.querySelector('.l-hero');
    if (!hero) return;
    const wrap = document.createElement('div');
    wrap.className = 'hero-dust';
    wrap.setAttribute('aria-hidden', 'true');
    hero.insertBefore(wrap, hero.firstChild);
    for (let i = 0; i < 160; i++) {
      const p = document.createElement('span');
      p.className = 'hero-dust__p';
      const sz   = (Math.random() * 3.2 + 0.8).toFixed(1);
      const left = (Math.random() * 100).toFixed(1);
      const bot  = (Math.random() * 100).toFixed(1);
      const dur  = (Math.random() * 8 + 5).toFixed(1) + 's';
      const del  = '-' + (Math.random() * 13).toFixed(1) + 's';
      const op   = (Math.random() * 0.45 + 0.10).toFixed(2);
      const dx   = ((Math.random() - 0.5) * 44).toFixed(0) + 'px';
      p.style.cssText =
        `width:${sz}px;height:${sz}px;left:${left}%;bottom:${bot}%;` +
        `--dur:${dur};--delay:${del};--op:${op};--drift-x:${dx};`;
      wrap.appendChild(p);
    }
  })();

  // ── Directional scroll-reveal ─────────────────────────────
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  const DELAYS = ['anim-d1', 'anim-d2', 'anim-d3', 'anim-d4'];

  // Category cards — 3-col grid: left / center-bottom / right
  document.querySelectorAll('.l-cat').forEach((el, i) => {
    const col = i % 3;
    el.classList.add('anim-hidden',
      col === 0 ? 'anim-from-left' : col === 2 ? 'anim-from-right' : 'anim-from-bottom',
      DELAYS[col]);
    revealObs.observe(el);
  });

  // Delivery cards: slide from sides
  document.querySelectorAll('.l-delivery-card').forEach((el, i) => {
    el.classList.add('anim-hidden', i === 0 ? 'anim-from-left' : 'anim-from-right');
    revealObs.observe(el);
  });

  // Steps: bottom with stagger
  document.querySelectorAll('.l-step').forEach((el, i) => {
    el.classList.add('anim-hidden', 'anim-from-bottom', DELAYS[i] ?? 'anim-d4');
    revealObs.observe(el);
  });

  // Benefits: bottom with stagger per column
  document.querySelectorAll('.l-benefit').forEach((el, i) => {
    el.classList.add('anim-hidden', 'anim-from-bottom', DELAYS[i % 3]);
    revealObs.observe(el);
  });

  // Section headings: fade from below
  document.querySelectorAll('.l-section-head').forEach(el => {
    el.classList.add('anim-hidden', 'anim-from-bottom');
    revealObs.observe(el);
  });
</script>

<style is:global>
  /* ── Hero golden dust ───────────────────────────────── */
  .hero-dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .hero-dust__p {
    position: absolute;
    border-radius: 50%;
    background: #C9A84C;
    will-change: transform, opacity;
    animation: dust-rise var(--dur) var(--delay) infinite ease-in-out;
  }
  @keyframes dust-rise {
    0%   { transform: translate(0, 0) scale(1);   opacity: 0; }
    15%  { opacity: var(--op); }
    85%  { opacity: var(--op); }
    100% { transform: translate(var(--drift-x), -130px) scale(0.6); opacity: 0; }
  }

  /* ── Scroll-reveal animations ───────────────────────── */
  .anim-hidden {
    opacity: 0;
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
  }
  .anim-from-bottom { transform: translateY(32px); }
  .anim-from-left   { transform: translateX(-36px); }
  .anim-from-right  { transform: translateX(36px); }
  .anim-hidden.is-visible { opacity: 1; transform: translate(0, 0); }
  .anim-d1 { transition-delay: 0.08s; }
  .anim-d2 { transition-delay: 0.16s; }
  .anim-d3 { transition-delay: 0.24s; }
  .anim-d4 { transition-delay: 0.32s; }

  @media (prefers-reduced-motion: reduce) {
    .anim-hidden { opacity: 1; transform: none; transition: none; }
    .hero-dust__p { animation: none; opacity: 0; }
  }
</style>
