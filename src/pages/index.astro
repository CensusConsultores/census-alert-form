}
/* ── Cierre ────────────────────────────────────────────────── */
.cierre { padding: var(--s7) 0; text-align: center; }
.cierre h2 { font-size: var(--t5); max-width: 18ch; margin: var(--s2) auto 0; }
.cierre .lead { margin: var(--s3) auto 0; max-width: 42ch; color: var(--papel-2); }
.cierre .ctas { justify-content: center; }

/* ── Pie ───────────────────────────────────────────────────── */
.pie-sitio { border-top: 1px solid var(--linea); padding: var(--s5) 0 var(--s4); }
.pie-sitio__in { display: flex; flex-direction: column; align-items: center; gap: var(--s3); text-align: center; }
.pie-sitio__logo { height: 46px; width: auto; opacity: .75; }
.pie-sitio__links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s3); }
.pie-sitio__links a { font-size: var(--t0); color: var(--tenue); transition: color .2s var(--out); }
.pie-sitio__links a:hover { color: var(--oro); }
.pie-sitio__legal { font-size: var(--t0); color: #6f6957; line-height: 1.6; max-width: 68ch; }

/* ── Revelado: una sola idea, con moderación ───────────────── */
.rv {
  opacity: 0; transform: translateY(14px);
