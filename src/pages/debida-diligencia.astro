const relacionadas = [
  { h: "/debida-diligencia-de-proveedores", t: "Debida diligencia de proveedores", d: "Cómo montar el filtro de homologación sin frenar a compras" },
  { h: "/compliance-uafe-sujetos-obligados", t: "Compliance y UAFE: sujetos obligados", d: "Qué exige el régimen de prevención de lavado en Ecuador" },
  { h: "/consultar-deudas-sri-por-ruc", t: "Consultar deudas del SRI por RUC", d: "El procedimiento oficial, paso a paso" },
