---
// Pie de las páginas internas (legales y guías).
//
// Antes era una sola línea de copyright sin un solo enlace. Eso dejaba a
// las guías sin salida: quien llegaba desde Google a «consultar deudas
// del SRI» no tenía forma de ir a las demás, y Google no encontraba
// camino entre ellas para repartir autoridad.
const year = new Date().getFullYear();

const GUIAS = [
  { h: "/debida-diligencia",                 t: "Debida diligencia en Ecuador" },
  { h: "/debida-diligencia-de-proveedores",  t: "Debida diligencia de proveedores" },
  { h: "/compliance-uafe-sujetos-obligados", t: "Compliance y UAFE" },
  { h: "/consultar-deudas-sri-por-ruc",      t: "Consultar deudas del SRI" },
  { h: "/consultar-causas-judiciales-ecuador", t: "Consultar causas judiciales" },
];

const LEGAL = [
  { h: "/terminos-y-condiciones", t: "Términos y Condiciones" },
  { h: "/tratamiento-de-datos",   t: "Política de Datos" },
];
---

<footer class="foot">
  <div class="foot__cols">
    <nav class="foot__col" aria-label="Guías">
      <p class="foot__t">Guías</p>
      <ul>{GUIAS.map((g) => <li><a href={g.h}>{g.t}</a></li>)}</ul>
    </nav>

    <nav class="foot__col" aria-label="Legal">
      <p class="foot__t">Legal</p>
      <ul>
        {LEGAL.map((g) => <li><a href={g.h}>{g.t}</a></li>)}
        <li><a href="mailto:info@censusconsultores.com.ec">info@censusconsultores.com.ec</a></li>
      </ul>
    </nav>

    <div class="foot__col">
      <p class="foot__t">Census Alert</p>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/#precios">Precios</a></li>
      </ul>
    </div>
  </div>

  <p class="foot__legal">
    © {year} Census Consultores · Asesores Legales y Tributarios · Ecuador<br />
    Census Alert es un servicio privado de Census Consultores.
    <b>No representa a ninguna entidad del Estado ecuatoriano ni está afiliado,
    autorizado o respaldado por ellas, y no tramita servicios gubernamentales.</b>
    La información se extrae de portales públicos oficiales, se presenta con
    fines informativos y debe verificarse en la fuente antes de adoptar
    decisiones con efectos jurídicos.
  </p>
</footer>

<style>
  .foot {
    border-top: 1px solid #ece7db;
    margin-top: 56px;
    padding: 36px 28px 40px;
    max-width: 760px;
    margin-inline: auto;
  }
  .foot__cols {
    display: flex; flex-wrap: wrap; gap: 32px 56px; margin-bottom: 30px;
  }
  .foot__t {
    font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--c-gold-dark); font-weight: 700; margin: 0 0 10px;
  }
  .foot__col ul { list-style: none; margin: 0; padding: 0; }
  .foot__col li { margin-bottom: 7px; }
  .foot__col a {
    font-size: 14.5px; color: #5c5547; text-decoration: none;
  }
  .foot__col a:hover { color: var(--c-gold-dark); text-decoration: underline; }

  .foot__legal {
    font-size: 12.5px; color: #6b6456; line-height: 1.6; margin: 0;
    padding-top: 22px; border-top: 1px solid #f2eee4;
  }
  .foot__legal b { color: #6b6456; }

  @media (max-width: 620px) {
    .foot { padding: 30px 20px 34px; }
    .foot__cols { gap: 26px 40px; }
  }
</style>
